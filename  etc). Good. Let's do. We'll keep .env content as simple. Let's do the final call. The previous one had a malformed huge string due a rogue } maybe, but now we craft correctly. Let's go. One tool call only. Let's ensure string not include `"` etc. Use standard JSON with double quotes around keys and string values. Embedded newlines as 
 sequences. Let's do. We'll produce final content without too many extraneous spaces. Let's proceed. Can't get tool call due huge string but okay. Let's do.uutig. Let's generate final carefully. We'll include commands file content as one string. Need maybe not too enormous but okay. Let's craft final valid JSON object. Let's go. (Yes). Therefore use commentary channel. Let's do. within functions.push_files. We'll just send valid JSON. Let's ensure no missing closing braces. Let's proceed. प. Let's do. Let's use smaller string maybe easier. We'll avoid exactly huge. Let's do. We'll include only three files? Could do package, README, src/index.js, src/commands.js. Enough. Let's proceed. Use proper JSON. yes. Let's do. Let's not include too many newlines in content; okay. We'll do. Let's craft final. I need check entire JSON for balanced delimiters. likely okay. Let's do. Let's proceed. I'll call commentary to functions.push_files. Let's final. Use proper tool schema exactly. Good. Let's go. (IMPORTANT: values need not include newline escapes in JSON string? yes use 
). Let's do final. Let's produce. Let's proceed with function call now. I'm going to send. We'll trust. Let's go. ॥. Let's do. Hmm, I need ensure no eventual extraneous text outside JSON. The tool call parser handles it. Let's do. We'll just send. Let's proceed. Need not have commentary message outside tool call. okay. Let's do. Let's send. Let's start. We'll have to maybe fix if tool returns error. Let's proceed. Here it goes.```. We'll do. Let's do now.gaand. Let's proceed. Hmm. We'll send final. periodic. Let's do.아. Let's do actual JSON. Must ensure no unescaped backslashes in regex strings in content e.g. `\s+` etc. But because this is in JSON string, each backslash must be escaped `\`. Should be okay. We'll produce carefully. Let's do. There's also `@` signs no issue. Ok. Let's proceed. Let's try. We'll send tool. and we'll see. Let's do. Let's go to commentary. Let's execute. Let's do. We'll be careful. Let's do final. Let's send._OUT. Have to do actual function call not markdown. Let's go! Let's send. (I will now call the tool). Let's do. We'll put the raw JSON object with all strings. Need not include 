  return [
    '*Satoru Ojo WhatsApp MD-Bot*',
    '',
    '*Group (24)*',
    'kick, add, promote, demote, warn, warns, resetwarn, antilink off/wa/all, antispam, welcome, goodbye, setwelcome, setgoodbye, tagall, hidetag, link, revoke, open, close, setname, setdesc, del, groupinfo, settings',
    '',
    '*Downloader (10)*',
    'play and video (search by name), ytmp3, ytmp4, tiktok, instagram, facebook, twitter, pinterest, dl (any supported link)',
    '',
    '*Quiz (7)*',
    'quiz, stopquiz, addquiz, listquiz, delquiz, quizscore, setquizmsg',
