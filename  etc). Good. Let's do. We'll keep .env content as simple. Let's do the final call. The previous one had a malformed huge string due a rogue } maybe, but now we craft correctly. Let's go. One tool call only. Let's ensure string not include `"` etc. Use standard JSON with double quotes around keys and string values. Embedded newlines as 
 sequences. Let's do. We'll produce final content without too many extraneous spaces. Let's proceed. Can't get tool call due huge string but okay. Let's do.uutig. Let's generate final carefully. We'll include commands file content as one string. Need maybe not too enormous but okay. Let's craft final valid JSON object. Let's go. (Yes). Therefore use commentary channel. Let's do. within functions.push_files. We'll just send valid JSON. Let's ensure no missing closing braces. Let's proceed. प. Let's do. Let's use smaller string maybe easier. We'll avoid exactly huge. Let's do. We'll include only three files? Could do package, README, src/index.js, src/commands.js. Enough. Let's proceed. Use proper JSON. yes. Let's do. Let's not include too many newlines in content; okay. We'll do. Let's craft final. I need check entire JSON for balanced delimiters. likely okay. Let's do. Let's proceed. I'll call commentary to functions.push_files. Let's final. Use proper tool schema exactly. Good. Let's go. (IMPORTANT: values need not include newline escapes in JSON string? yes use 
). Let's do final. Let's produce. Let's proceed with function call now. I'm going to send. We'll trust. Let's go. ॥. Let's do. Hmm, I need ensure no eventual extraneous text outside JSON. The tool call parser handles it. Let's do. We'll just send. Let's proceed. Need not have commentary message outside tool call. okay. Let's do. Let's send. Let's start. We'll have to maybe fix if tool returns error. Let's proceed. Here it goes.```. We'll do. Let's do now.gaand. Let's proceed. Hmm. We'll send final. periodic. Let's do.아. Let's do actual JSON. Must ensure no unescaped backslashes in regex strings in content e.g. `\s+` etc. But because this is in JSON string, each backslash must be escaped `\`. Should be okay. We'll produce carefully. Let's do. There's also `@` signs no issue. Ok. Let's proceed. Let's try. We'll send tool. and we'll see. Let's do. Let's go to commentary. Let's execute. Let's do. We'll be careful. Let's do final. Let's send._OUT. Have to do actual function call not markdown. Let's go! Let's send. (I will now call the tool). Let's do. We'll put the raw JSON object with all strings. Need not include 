const DEFAULT_PREFIXES = ['!', '/', '.'];

export const appState = {
  warns: new Map(),
  quizzes: new Map(),
  poll: {
    active: false,
    prompt: '',
    options: [],
    voters: new Map(),
  },
};

const GROUP_COMMANDS = [
  'kick', 'add', 'promote', 'demote', 'warn', 'warns', 'resetwarn',
  'antilink off', 'antilink wa', 'antilink all', 'antispam', 'welcome', 'goodbye',
  'setwelcome', 'setgoodbye', 'tagall', 'hidetag', 'link', 'revoke', 'open', 'close',
  'setname', 'setdesc', 'del', 'groupinfo', 'settings'
];

const DOWNLOAD_COMMANDS = [
  'play', 'video', 'ytmp3', 'ytmp4', 'tiktok', 'instagram', 'facebook', 'twitter',
  'pinterest', 'dl'
];

const QUIZ_COMMANDS = ['quiz', 'stopquiz', 'addquiz', 'listquiz', 'delquiz', 'quizscore', 'setquizmsg'];
const POLL_COMMANDS = ['poll', 'mpoll', 'setpollmsg'];
const FUN_COMMANDS = ['8ball', 'dice', 'joke', 'calc', 'getpp', 'join', 'leave', 'restart', 'menu', 'ping'];

